{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/demo-data/:path*", "destination": "/demo-data/:path*" },
    { "source": "/static/:path*", "destination": "/static/:path*" },
    { "source": "/((?!api|static|demo-data).*)", "destination": "/index.html" }
  ]
}
